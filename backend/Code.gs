      midPay.status === 'APPROVING' &&
      ((midInv1.status === 'APPROVING' && midInv2.status === 'AWAITING_VERIFICATION') ||
        (midInv1.status === 'AWAITING_VERIFICATION' && midInv2.status === 'APPROVING')) &&
      recoveryRun1.journalRecovery.recoveredCount >= 1 &&
