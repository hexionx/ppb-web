          });
        }
      }
    }

    var assessmentDtos = [];
    for (var aIdx = 0; aIdx < assessmentsTbl.records.length; aIdx++) {
      assessmentDtos.push(
        buildAssessmentDtoStep7_(assessmentsTbl.records[aIdx], 0, [])
