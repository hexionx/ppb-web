/**
 * Code.gs
 * Pattanabhumi Biology Learning Management System - Step 5 Shell, Navigation & Privacy Gate
 *
 * Responsibilities:
 * - Provide the Web App HTTP GET entry point: doGet(e) (strictly read-only).
 * - Provide a private, allowlisted static HTML partial include helper: includePartial_(name).
 * - Provide the single public RPC dispatcher callable from google.script.run: rpcDispatch(requestEnvelope).
 * - Register Step 4 & Step 5 public and protected actions (`auth.login`, `auth.logout`,
 *   `auth.getSessionStatus`, `privacy.acknowledge`, `privacy.updateMarketing`,
 *   `student.getProfile`, `admin.getDashboardSummary`, `admin.updateSchoolSettings`,
 *   `admin.createStudentAccount`).
 * - Enforce `requireAuthenticatedSessionGuard_` AND `requiresPrivacyAck` (`ERR_PRIVACY_ACK_REQUIRED`)
 *   on protected actions.
 *
 * Security Note:
 * - Only doGet and rpcDispatch are public functions across the entire project.
 * - Setup, bootstrap, database, cryptographic, privacy, and rate-limiting helpers end with an
 *   underscore (_) so they cannot be invoked directly from the browser.
 */

/**
 * Web App HTTP GET entry point. Serves the HTML Service application shell.
 * Kept strictly free of state-changing behavior.
 *
 * @param {Object} e Apps Script HTTP GET event object.
 * @return {HtmlOutput} Evaluated HTML Service output.
 */
function doGet(e) {
  var template = HtmlService.createTemplateFromFile('Index');
  var htmlOutput = template.evaluate();

  htmlOutput
    .setTitle(
      PB_APP_CONSTANTS_.SCHOOL_NAME_DEFAULT +
        ' - Learning Portal'
    )
    .addMetaTag('viewport', 'width=device-width, initial-scale=1')
    .setSandboxMode(HtmlService.SandboxMode.IFRAME)
    .setXFrameOptionsMode(
      HtmlService.XFrameOptionsMode && HtmlService.XFrameOptionsMode.ALLOWALL
        ? HtmlService.XFrameOptionsMode.ALLOWALL
        : HtmlService.XFrameOptionsMode.DEFAULT
    );

  return htmlOutput;
}
function includePartial_(partialName) {
  var isAllowed =
    typeof partialName === 'string' &&
    (partialName === 'LoginView' ||
      (typeof PB_ALLOWED_HTML_PARTIALS_ === 'object' &&
        PB_ALLOWED_HTML_PARTIALS_ !== null &&
        Object.prototype.hasOwnProperty.call(
          PB_ALLOWED_HTML_PARTIALS_,
          partialName
        ) &&
        PB_ALLOWED_HTML_PARTIALS_[partialName] === true));

  if (!isAllowed) {
    throw new Error(
      'Disallowed or unknown HTML partial requested: ' + String(partialName)
    );
  }

  var content = HtmlService.createHtmlOutputFromFile(partialName).getContent();

  /*
   * HtmlService.createHtmlOutputFromFile() returns raw static HTML and does not
   * recursively evaluate nested `<?!= includePartial_(...) ?>` tags inside partials.
   * When loading `StatusView`, statically splice `LoginView` in place.
   */
  if (partialName === 'StatusView') {
    var loginContent = '';
    try {
      loginContent =
        HtmlService.createHtmlOutputFromFile('LoginView').getContent();
    } catch (missingLoginViewFileErr) {
      loginContent = '';
    }

    var hasStep5ModalInStatus = content.indexOf('id="modal-login"') !== -1;
    var hasStep5ModalInLogin = loginContent.indexOf('id="modal-login"') !== -1;

    if (content.indexOf('includePartial_') !== -1) {
      content = content.replace(
        /<\?!=?\s*includePartial_\(\s*['"]LoginView['"]\s*\);?\s*\?>/g,
        function () {
          if (hasStep5ModalInStatus) {
            return '';
          }
          return hasStep5ModalInLogin ? loginContent : '';
        }
      );
    } else if (!hasStep5ModalInStatus && hasStep5ModalInLogin) {
      content = loginContent + '\n' + content;
    }
  }

  return content;
}
