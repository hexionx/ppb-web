  results.push({
    test: '1. RFC 6070 PBKDF2-HMAC-SHA256 Vectors (c=1, c=2, c=4096)',
    passed: cryptoReport.vectorsPassed === true,
    detail: JSON.stringify(cryptoReport)
  });

  var sampleHash = hashPassword_('CorrectHorseBatteryStaple!26', 'test_user');
  var matchOk = verifyPassword_('CorrectHorseBatteryStaple!26', sampleHash);
  var wrongRejected = !verifyPassword_('WrongPassword!26', sampleHash);
  results.push({
    test: '2. PBKDF2 Hash & Constant-Time Verification (10,000 iterations)',
    passed: matchOk && wrongRejected,
    detail: 'Hash prefix: ' + sampleHash.substring(0, 28) + '...'
  });

  var shortRejected = false;
  try {
    validatePasswordInputBytes_('short', true);
  } catch (err) {
    shortRejected = err.code === PB_ERROR_CODES_.ERR_VALIDATION_FAILED;
  }
  results.push({
    test: '3. Password Minimum/Maximum Length & Byte Validation',
    passed: shortRejected,
    detail: 'Short password rejected with ERR_VALIDATION_FAILED'
  });

  var tok1 = generateSessionTokenHex_('usr_test_1');
  var tok2 = generateSessionTokenHex_('usr_test_1');
  var tokensDistinct =
    tok1.length === 64 &&
    tok2.length === 64 &&
    !constantTimeEqual_(tok1, tok2) &&
    !constantTimeEqual_(sha256Hex_(tok1), sha256Hex_(tok2));
  results.push({
    test: '4. CSPRNG 256-Bit Token Generation & SHA-256 Digest Uniqueness',
    passed: tokensDistinct,
    detail: 'Generated two distinct 64-hex tokens and 64-hex SHA-256 digests'
  });

  var allPassed = true;
  for (var i = 0; i < results.length; i++) {
    if (!results[i].passed) {
      allPassed = false;
    }
  }

  var summary = {
    allPassed: allPassed,
    benchmarkMsFor10000Iterations: cryptoReport.benchmarkElapsedMs,
    results: results
  };
  Logger.log('Step 4 Verification Suite Summary: ' + JSON.stringify(summary));
  return summary;
}
/** Extracts a clean Google Drive File ID whether the administrator or Script Property */
function extractDriveFileIdFromInput_(rawInput) {
  if (typeof rawInput !== 'string') {
    return '';
  }
  var trimmed = rawInput.trim();
  if (!trimmed) {
    return '';
  }
  if (trimmed.indexOf('fil_') === 0) {
    return trimmed;
  }
  var fileMatch = trimmed.match(/\/file\/d\/([A-Za-z0-9_-]{10,})/);
  if (fileMatch && fileMatch[1]) {
    return fileMatch[1];
  }
  var idParamMatch = trimmed.match(/[?&]id=([A-Za-z0-9_-]{10,})/);
  if (idParamMatch && idParamMatch[1]) {
    return idParamMatch[1];
  }
  var dMatch = trimmed.match(/\/d\/([A-Za-z0-9_-]{10,})/);
  if (dMatch && dMatch[1]) {
    return dMatch[1];
  }
  return trimmed;
}
var PB_DEFAULT_PSD_CONVERTED_LOGO_WEBP_B64_ = '';

function detectLogoRasterSignatureSafe_(rawBytes) {
  if (!Array.isArray(rawBytes) || rawBytes.length < 4) {
    return {
      validRaster: false,
      isPhotoshopPsd: false,
      mimeType: '',
      formatLabel: 'EMPTY_OR_TOO_SHORT',
      detectedHeaderDesc: 'File has fewer than 4 bytes.'
    };
  }
  function u8(idx) {
    return (rawBytes[idx] + 256) % 256;
  }
  var b0 = u8(0);
  var b1 = u8(1);
  var b2 = u8(2);
  var b3 = u8(3);

  /* PNG: 89 50 4E 47 0D 0A 1A 0A */
  if (
    rawBytes.length >= 8 &&
    b0 === 0x89 &&
    b1 === 0x50 &&
    b2 === 0x4e &&
    b3 === 0x47 &&
    u8(4) === 0x0d &&
    u8(5) === 0x0a &&
    u8(6) === 0x1a &&
    u8(7) === 0x0a
  ) {
    return {
      validRaster: true,
      isPhotoshopPsd: false,
      mimeType: 'image/png',
      formatLabel: 'PNG',
      detectedHeaderDesc: 'PNG magic signature (89 50 4E 47 0D 0A 1A 0A)'
    };
  }
  /* JPEG: FF D8 FF */
  if (b0 === 0xff && b1 === 0xd8 && b2 === 0xff) {
    return {
      validRaster: true,
      isPhotoshopPsd: false,
      mimeType: 'image/jpeg',
      formatLabel: 'JPEG',
      detectedHeaderDesc: 'JPEG magic signature (FF D8 FF)'
    };
  }
  /* WebP: RIFF....WEBP */
  if (
    rawBytes.length >= 12 &&
    b0 === 0x52 &&
    b1 === 0x49 &&
    b2 === 0x46 &&
    b3 === 0x46 &&
    u8(8) === 0x57 &&
    u8(9) === 0x45 &&
    u8(10) === 0x42 &&
    u8(11) === 0x50
  ) {
    return {
      validRaster: true,
      isPhotoshopPsd: false,
      mimeType: 'image/webp',
      formatLabel: 'WEBP',
      detectedHeaderDesc: 'WebP magic signature (RIFF....WEBP)'
    };
  }
  /* Adobe Photoshop PSD: 38 42 50 53 ("8BPS") */
  if (
    rawBytes.length >= 26 &&
    b0 === 0x38 &&
    b1 === 0x42 &&
    b2 === 0x50 &&
    b3 === 0x53
  ) {
    var psdChannels = (u8(12) << 8) | u8(13);
    var psdHeight =
      (u8(14) << 24) | (u8(15) << 16) | (u8(16) << 8) | u8(17);
    var psdWidth =
      (u8(18) << 24) | (u8(19) << 16) | (u8(20) << 8) | u8(21);
    return {
      validRaster: false,
      isPhotoshopPsd: true,
      psdChannels: psdChannels,
      psdWidth: psdWidth,
      psdHeight: psdHeight,
      mimeType: 'image/x-photoshop',
      formatLabel: 'PSD',
      detectedHeaderDesc:
        'Adobe Photoshop PSD (8BPS, ' +
        psdWidth +
        'x' +
        psdHeight +
        ', ' +
        psdChannels +
        ' channels) - browsers cannot render raw .psd files directly without raster conversion to PNG/WebP'
    };
  }
  return {
    validRaster: false,
    isPhotoshopPsd: false,
    mimeType: '',
    formatLabel: 'UNSUPPORTED',
    detectedHeaderDesc: 'Unsupported binary signature. Convert the file to PNG, JPEG, or WebP.'
  };
}
