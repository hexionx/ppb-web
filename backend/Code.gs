 * the currently configured spreadsheet or clean schema headers.
 *
 * @param {boolean=} opt_cloneExistingData If true, copies existing rows into the disposable clone;
 *   otherwise starts from clean schema headers.
 * @return {Object} Disposable in-memory Spreadsheet implementing getSheetByName, insertSheet, getId.
 */
function createSyntheticInMemorySpreadsheetStep15_(opt_cloneExistingData) {
  var sheetMap = {};
