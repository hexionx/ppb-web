/**
 * Creates a new class or school-wide calendar event directly from the web interface (`admin.createCalendarEvent`).
 *
 * @param {Object} authContext Verified session context.
 * @param {Object} payload Event creation payload.
 * @return {Object} Created event spec and confirmation message.
 */
function adminCreateCalendarEventStep13_(authContext, payload) {
  if (!authContext || !authContext.user || authContext.user.role !== 'ADMIN') {
    throw createAppError_(
      PB_ERROR_CODES_.ERR_FORBIDDEN_ROLE,
      'Only an administrator can create calendar events.'
    );
  }
  var req = payload && typeof payload === 'object' ? payload : {};
  var fieldErrors = {};

  var title = sanitizeCalendarEventTitleStep13_(req.title || '');
  if (!title || title.length < 2 || title === 'Untitled Class Session') {
    if (!String(req.title || '').trim() || String(req.title || '').trim().length < 2) {
      fieldErrors.title = 'Event title is required (2 to 160 characters).';
    }
  }

  var scopeType = String(req.scopeType || 'COURSE').trim().toUpperCase();
  if (scopeType !== 'COURSE' && scopeType !== 'SCHOOL_WIDE') {
    fieldErrors.scopeType = 'Event scope must be COURSE or SCHOOL_WIDE.';
  }

  var courseId = String(req.courseId || '').trim();
  if (scopeType === 'COURSE' && !courseId) {
    fieldErrors.courseId = 'Please select a course for a course-specific class session.';
  }

  var startDateBkk = String(req.startDateBkk || '').trim();
  if (!/^\d{4}-\d{2}-\d{2}$/.test(startDateBkk)) {
    fieldErrors.startDateBkk = 'Please enter a valid start date (YYYY-MM-DD).';
  }

  var endDateBkk = String(req.endDateBkk || startDateBkk).trim() || startDateBkk;
  if (!/^\d{4}-\d{2}-\d{2}$/.test(endDateBkk)) {
    fieldErrors.endDateBkk = 'Please enter a valid end date (YYYY-MM-DD).';
  } else if (startDateBkk && endDateBkk < startDateBkk) {
    fieldErrors.endDateBkk = 'End date cannot be earlier than start date.';
  }

  var isAllDay = Boolean(req.isAllDay);
  var startTimeHm = String(req.startTimeHm || '09:00').trim();
  var endTimeHm = String(req.endTimeHm || '11:00').trim();

  if (!isAllDay) {
    if (!/^([01]\d|2[0-3]):([0-5]\d)$/.test(startTimeHm)) {
      fieldErrors.startTimeHm = 'Start time must be in HH:MM (24-hour) format.';
    }
    if (!/^([01]\d|2[0-3]):([0-5]\d)$/.test(endTimeHm)) {
      fieldErrors.endTimeHm = 'End time must be in HH:MM (24-hour) format.';
    }
  }

  if (Object.keys(fieldErrors).length > 0) {
    throw createAppError_(
      PB_ERROR_CODES_.ERR_VALIDATION_FAILED,
      'Please check the highlighted calendar event fields.',
      fieldErrors
    );
  }

  var cleanLocation = sanitizeCalendarEventLocationStep13_(req.location || '');
  var markerLine =
    scopeType === 'COURSE' ? 'PB_COURSE_ID: [' + courseId + ']' : 'PB_ALL_STUDENTS';
  var extraNotes = String(req.descriptionNotes || '').trim().slice(0, 600);
  var fullDescription = extraNotes ? markerLine + '\n' + extraNotes : markerLine;

  var newEventId = 'evt_web_' + Utilities.getUuid().replace(/[^a-zA-Z0-9]/g, '').slice(0, 18);
  var spec = {
    eventId: newEventId,
    title: title,
    description: fullDescription,
    location: cleanLocation,
    isAllDay: isAllDay,
    isRecurring: false,
    createdByAdminId: authContext.user.user_id,
    createdAtUtc: nowUtcIso_()
  };

  if (isAllDay) {
    var endMidnightUtcMs = bangkokYmdStartToUtcMsStep13_(endDateBkk);
    var exclusiveEndUtcMs = endMidnightUtcMs + 24 * 3600 * 1000;
    spec.allDayStartDateBkk = startDateBkk;
    spec.allDayEndDateExclusiveBkk = formatUtcMsToBangkokDateStrStep13_(exclusiveEndUtcMs);
  } else {
    var sParts = startTimeHm.split(':');
    var eParts = endTimeHm.split(':');
    var startUtcMs =
      bangkokYmdStartToUtcMsStep13_(startDateBkk) +
      (Number(sParts[0]) * 60 + Number(sParts[1])) * 60 * 1000;
    var endUtcMs =
      bangkokYmdStartToUtcMsStep13_(endDateBkk) +
      (Number(eParts[0]) * 60 + Number(eParts[1])) * 60 * 1000;
    if (endUtcMs <= startUtcMs) {
      endUtcMs = startUtcMs + 60 * 60 * 1000;
    }
    spec.startUtcIso = new Date(startUtcMs).toISOString();
    spec.endUtcIso = new Date(endUtcMs).toISOString();
  }

  return withScriptLock_(function () {
    var customList = readPortalCustomCalendarEventsStep13_();
    customList.push(spec);
    savePortalCustomCalendarEventsStep13_(customList);

    var createTitleNorm = String(title || '').trim().toLowerCase();
    if (createTitleNorm) {
      var existingDeletedMap = readPortalDeletedCalendarEventIdsStep13_();
      if (existingDeletedMap && existingDeletedMap['title:' + createTitleNorm]) {
        delete existingDeletedMap['title:' + createTitleNorm];
        savePortalDeletedCalendarEventIdsStep13_(existingDeletedMap);
      }
    }

    /* Also create in live Google Calendar if configured and writable */
    var calConfig = resolveConfiguredCalendarIdStep13_();
    if (
      calConfig.configured &&
      typeof CalendarApp !== 'undefined' &&
      CalendarApp &&
      typeof CalendarApp.getCalendarById === 'function'
    ) {
      try {
        var calObj = CalendarApp.getCalendarById(calConfig.calendarId);
        if (calObj) {
          if (isAllDay && typeof calObj.createAllDayEvent === 'function') {
            calObj.createAllDayEvent(
              title,
              new Date(bangkokYmdStartToUtcMsStep13_(startDateBkk)),
              new Date(bangkokYmdStartToUtcMsStep13_(spec.allDayEndDateExclusiveBkk)),
              { description: fullDescription, location: cleanLocation }
            );
          } else if (!isAllDay && typeof calObj.createEvent === 'function') {
            calObj.createEvent(
              title,
              new Date(spec.startUtcIso),
              new Date(spec.endUtcIso),
              { description: fullDescription, location: cleanLocation }
            );
          }
        }
      } catch (ignoreLiveCreateErr) {}
    }

    recordAuditEvent_({
      actorUserId: authContext.user.user_id,
      actorRole: 'ADMIN',
      eventType: 'ADMIN_CALENDAR_EVENT_CREATED',
      targetEntityType: 'CalendarEvent',
      targetEntityId: newEventId,
      summary: {
        title: title,
        scopeType: scopeType,
        courseId: courseId,
        startDateBkk: startDateBkk,
        endDateBkk: endDateBkk,
        isAllDay: isAllDay
      }
    });

    return {
      created: true,
      eventId: newEventId,
      eventSpec: spec,
      monthKey: startDateBkk.slice(0, 7),
      savedMessage: 'Added calendar event "' + title + '" on ' + startDateBkk + '.'
    };
  });
}

function handleAdminCreateCalendarEventStep13_(payload, context) {
  return adminCreateCalendarEventStep13_(context.authContext, payload);
}

/**
 * Removes/deletes a calendar event directly from the web interface (`admin.deleteCalendarEvent`).
 *
 * @param {Object} authContext Verified session context.
 * @param {Object} payload `{ eventId: string }`.
 * @return {Object} Deletion confirmation.
 */
function adminDeleteCalendarEventStep13_(authContext, payload) {
  if (!authContext || !authContext.user || authContext.user.role !== 'ADMIN') {
    throw createAppError_(
      PB_ERROR_CODES_.ERR_FORBIDDEN_ROLE,
      'Only an administrator can remove calendar events.'
    );
  }
  var req = payload && typeof payload === 'object' ? payload : {};
  var eventId = String(req.eventId || '').trim();
  if (!eventId) {
    throw createAppError_(
      PB_ERROR_CODES_.ERR_VALIDATION_FAILED,
      'eventId is required to remove a calendar event.',
      { eventId: 'Missing eventId.' }
    );
  }

  return withScriptLock_(function () {
    var reqTitleNorm = String(req.title || '').trim().toLowerCase();
    var customList = readPortalCustomCalendarEventsStep13_();
    var nextList = [];
    for (var i = 0; i < customList.length; i++) {
      var cItem = customList[i] || {};
      var cTitleNorm = String(cItem.title || '').trim().toLowerCase();
      if (
        String(cItem.eventId || '') !== eventId &&
        !(reqTitleNorm && cTitleNorm === reqTitleNorm)
      ) {
        nextList.push(cItem);
      }
    }
    savePortalCustomCalendarEventsStep13_(nextList);

    var deletedMap = readPortalDeletedCalendarEventIdsStep13_();
    deletedMap[eventId] = true;
    if (reqTitleNorm) {
      deletedMap['title:' + reqTitleNorm] = true;
    }
    savePortalDeletedCalendarEventIdsStep13_(deletedMap);

    /* Also attempt to delete from live Google Calendar if present */
    var calConfig = resolveConfiguredCalendarIdStep13_();
    if (
      calConfig.configured &&
      typeof CalendarApp !== 'undefined' &&
      CalendarApp &&
      typeof CalendarApp.getCalendarById === 'function'
    ) {
      try {
        var calObj = CalendarApp.getCalendarById(calConfig.calendarId);
        if (calObj) {
          var deletedLive = false;
          if (typeof calObj.getEventById === 'function') {
            var liveEv = calObj.getEventById(eventId);
            if (liveEv && typeof liveEv.deleteEvent === 'function') {
              liveEv.deleteEvent();
              deletedLive = true;
            }
          }
          if ((!deletedLive || reqTitleNorm) && typeof calObj.getEvents === 'function') {
            var searchStart = new Date(Date.now() - 180 * 86400000);
            var searchEnd = new Date(Date.now() + 365 * 86400000);
            var allLiveEvs = calObj.getEvents(searchStart, searchEnd) || [];
            for (var leIdx = 0; leIdx < allLiveEvs.length; leIdx++) {
              var candEv = allLiveEvs[leIdx];
              if (!candEv) continue;
              var candId = typeof candEv.getId === 'function' ? String(candEv.getId() || '').trim() : '';
              var candTitle = typeof candEv.getTitle === 'function' ? String(candEv.getTitle() || '').trim().toLowerCase() : '';
              if (candId === eventId || (reqTitleNorm && candTitle === reqTitleNorm)) {
                if (typeof candEv.deleteEvent === 'function') {
                  candEv.deleteEvent();
                }
              }
            }
          }
        }
      } catch (ignoreLiveDelErr) {}
    }

    recordAuditEvent_({
      actorUserId: authContext.user.user_id,
      actorRole: 'ADMIN',
      eventType: 'ADMIN_CALENDAR_EVENT_DELETED',
      targetEntityType: 'CalendarEvent',
      targetEntityId: eventId,
      summary: { deletedEventId: eventId }
    });

    return {
      deleted: true,
      deletedEventId: eventId,
      savedMessage: 'Removed calendar event from schedule.'
    };
  });
}

function handleAdminDeleteCalendarEventStep13_(payload, context) {
  return adminDeleteCalendarEventStep13_(context.authContext, payload);
}

function handleCalendarGetEventsStep13_(payload, context) {
  return getAuthorizedClassCalendarEventsStep13_(context.authContext, payload);
}

/**
 * Administrator helper (`admin.seedStep13SampleCalendarEvents`) that seeds the Step 9/13
 * learning cohort if needed and enables the Step 13 sample calendar events for immediate
 * browser testing across `student_a`, `student_b`, `student_c`, and `ADMIN`.
 */
function adminSeedStep13SampleCalendarEvents_(authContext, payload) {
  if (!authContext || !authContext.user || authContext.user.role !== 'ADMIN') {
    throw createAppError_(
      PB_ERROR_CODES_.ERR_FORBIDDEN_ROLE,
      'Only an administrator can enable or seed sample calendar events.'
    );
  }
  var req = payload && typeof payload === 'object' ? payload : {};
  if (typeof adminSeedStep9LearningCohort_ === 'function') {
    adminSeedStep9LearningCohort_(authContext, {});
  }

  var enableFlag = req.enabled !== false;
  PB_STEP13_IN_MEMORY_SAMPLE_EVENTS_ = enableFlag;
  try {
    var props = PropertiesService.getScriptProperties();
    props.setProperty(
      'STEP13_SAMPLE_EVENTS_ENABLED',
      enableFlag ? 'TRUE' : 'FALSE'
    );
  } catch (ignoreErr) {}

  var monthKey =
    typeof req.month === 'string' && /^\d{4}-\d{2}$/.test(req.month)
      ? req.month
      : formatUtcMsToBangkokDateStrStep13_(Date.now()).slice(0, 7);
  var bundle = buildStep13CanonicalSampleEventSpecs_(monthKey);

  recordAuditEvent_({
    actorUserId: authContext.user.user_id,
    actorRole: 'ADMIN',
    eventType: 'ADMIN_CALENDAR_SAMPLE_EVENTS_CONFIGURED',
    targetEntityType: 'Calendar',
    targetEntityId: monthKey,
    summary: {
      monthKey: monthKey,
      sampleEventsEnabled: enableFlag,
      sampleSpecsCount: bundle.specs.length,
      courseAId: bundle.courseAId,
      courseBId: bundle.courseBId
    }
  });

  return {
    sampleEventsEnabled: enableFlag,
    monthKey: monthKey,
    courseAId: bundle.courseAId,
    courseBId: bundle.courseBId,
    draftCourseId: bundle.draftCourseId,
    sampleSpecsCount: bundle.specs.length,
    savedMessage: enableFlag
      ? 'Enabled Step 13 sample calendar events for ' +
        monthKey +
        ' (Course A: ' +
        bundle.courseAId +
        ', Course B: ' +
        bundle.courseBId +
        ', School-Wide: PB_ALL_STUDENTS, plus unmarked/invalid/draft negative test events).'
      : 'Disabled Step 13 sample calendar events (using live Google Calendar only).'
  };
}

