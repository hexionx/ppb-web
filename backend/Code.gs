  if (payload.logoFileIdOverride !== undefined) {
    var logoVal = String(payload.logoFileIdOverride || '').trim();
    if (logoVal !== '' && !/^[A-Za-z0-9_-]{8,120}$/.test(logoVal)) {
      fieldErrors.logoFileIdOverride =
