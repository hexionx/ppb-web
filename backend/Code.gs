    if (sec.course_id === courseId && sec.status === 'PUBLISHED') {
      courseSections.push(sec);
    }
  }
  courseSections.sort(function (a, b) {
    var diff = (Number(a.sort_order) || 0) - (Number(b.sort_order) || 0);
    if (diff !== 0) {
      return diff;
