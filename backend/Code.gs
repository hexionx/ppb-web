    }

    var enrolledReadOk = false;
    var courseDetailRes = handleStudentGetCourseDetailStep7_({ courseId: synth.pubCourseId }, { authContext: enrolledCtx });
    enrolledReadOk =
      Boolean(courseDetailRes) &&
      Boolean(courseDetailRes.course) &&
      courseDetailRes.course.courseId === synth.pubCourseId;

    /* Revoke enrollment and verify immediate block */
    var enrRow = getSheetRecordById_('Enrollments', synth.enrId);
    updateSheetRecordById_(
      'Enrollments',
      synth.enrId,
