      totalAdmins: 0,
      activeStudents: 0,
      inactiveStudents: 0,
      totalActiveEnrollments: 0
    };
    for (var s = 0; s < usersTbl.records.length; s++) {
      var ur = usersTbl.records[s];
      if (ur.role === 'ADMIN') {
        summaryCounts.totalAdmins += 1;
      } else if (ur.role === 'STUDENT') {
        if (ur.status === 'ACTIVE') {
