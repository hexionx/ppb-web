    };

    var unauthCourseCode = '';
    try {
      handleStudentGetCourseDetailStep7_({ courseId: synth.pubCourseId }, { authContext: otherStuCtx });
    } catch (eUnauthCrs) {
      unauthCourseCode = eUnauthCrs.pbCode || eUnauthCrs.code || '';
