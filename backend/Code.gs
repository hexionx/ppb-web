    }

    recordCheck(
      'S15-AUTH-01',
      '2. Authentication',
      'PBKDF2-HMAC-SHA256 (>= 10,000 iterations) enforced, plaintext hashes rejected, disabled users blocked, no password_hash/token_hash returned, and logout revokes session',
      plaintextRejected === true &&
        disabledLoginCode === 'ERR_ACCOUNT_SUSPENDED' &&
        leaksPasswordHash === false &&
        postLogoutCode === 'ERR_AUTH_REQUIRED',
      {
        plaintextRejected: plaintextRejected,
