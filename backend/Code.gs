            fullName: uHit.record.full_name || '',
            email: uHit.record.email || '',
            userStatus: uHit.record.status || 'ACTIVE',
            assignedAtUtc: enr.assigned_at_utc || '',
            assignedAtBangkok: enr.assigned_at_utc
