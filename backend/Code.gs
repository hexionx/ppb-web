      }
    );

    return {
      executedAndPassed: executedAndPassed,
      executedAndFailed: executedAndFailed
    };
  });

  var hostPostFingerprint = null;
  var productionZeroMutationVerified = true;
  if (hostPreFingerprint) {
    hostPostFingerprint = computeSpreadsheetStateFingerprintStep15_(
      PB_REQUEST_SPREADSHEET_CACHE_
    );
