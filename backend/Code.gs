      sessionId: sessionId,
      expiresAtUtc: expiresAtIso,
      expiresAtBangkok: formatBangkokTimestamp_(expiresAtIso),
      rememberMe: rememberMe,
      privacyNoticeVersion: currentNoticeVersion,
