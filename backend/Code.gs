  };
}

/**
 * Computes a deterministic row-count and content digest of a spreadsheet instance
 * so the test runner can prove zero production rows were mutated.
 *
 * @param {Object} spreadsheet Spreadsheet instance to fingerprint.
 * @return {{ totalRows: number, perSheetCounts: Object<string, number>, sha256Hex: string }}
 */
function computeSpreadsheetStateFingerprintStep15_(spreadsheet) {
  var perSheet = {};
  var totalRows = 0;
  var parts = [];
  if (!spreadsheet || typeof spreadsheet.getSheetByName !== 'function') {
    return { totalRows: 0, perSheetCounts: {}, sha256Hex: 'EMPTY' };
  }
  for (var i = 0; i < PB_SHEET_NAMES_.length; i++) {
    var sName = PB_SHEET_NAMES_[i];
    var schema = PB_SHEET_SCHEMAS_[sName];
    var sh = spreadsheet.getSheetByName(sName);
    var lRow = sh ? sh.getLastRow() : 0;
    perSheet[sName] = lRow;
    totalRows += lRow;
    if (sh && lRow > 0) {
      var vals = sh.getRange(1, 1, lRow, schema.headers.length).getValues();
      parts.push(sName + ':' + lRow + ':' + JSON.stringify(vals));
    } else {
      parts.push(sName + ':0:[]');
    }
  }
  var digestBytes = Utilities.computeDigest(
    Utilities.DigestAlgorithm.SHA_256,
    parts.join('|'),
    Utilities.Charset.UTF_8
  );
  return {
    totalRows: totalRows,
    perSheetCounts: perSheet,
    sha256Hex: bytesToHex_(digestBytes)
  };
}

