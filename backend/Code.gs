    }
  }

  function makeDisposableSheet(name, initialRows) {
    var rows = [];
    for (var r = 0; r < initialRows.length; r++) {
      rows.push(initialRows[r].slice());
    }
    return {
      _name: name,
      _rows: rows,
      _frozen: 1,
      getName: function () {
        return this._name;
      },
      getLastRow: function () {
        return this._rows.length;
      },
      getLastColumn: function () {
        return this._rows.length > 0 ? this._rows[0].length : 0;
      },
      setFrozenRows: function (n) {
        this._frozen = n;
      },
      appendRow: function (arr) {
        this._rows.push(
          arr.map(function (v) {
            return v === undefined || v === null ? '' : v;
          })
        );
      },
      deleteRow: function (rowNum) {
        if (rowNum >= 1 && rowNum <= this._rows.length) {
          this._rows.splice(rowNum - 1, 1);
        }
      },
      insertRowBefore: function (rowNum) {
        var colCount = this.getLastColumn() || 1;
        var blank = [];
        for (var c = 0; c < colCount; c++) blank.push('');
        this._rows.splice(Math.max(0, rowNum - 1), 0, blank);
      },
      getRange: function (row, col, numRows, numCols) {
        var self = this;
        var rCount = numRows || 1;
        var cCount = numCols || 1;
        return {
          getValues: function () {
            var out = [];
            for (var rr = 0; rr < rCount; rr++) {
              var srcRow = self._rows[row - 1 + rr] || [];
              var line = [];
              for (var cc = 0; cc < cCount; cc++) {
                var val = srcRow[col - 1 + cc];
                line.push(val === undefined ? '' : val);
              }
              out.push(line);
            }
            return out;
          },
          setValue: function (val) {
            while (self._rows.length < row) {
              self._rows.push([]);
            }
            self._rows[row - 1][col - 1] = val;
          },
          setValues: function (matrix) {
            for (var rr = 0; rr < matrix.length; rr++) {
              var targetRowIdx = row - 1 + rr;
              while (self._rows.length <= targetRowIdx) {
                self._rows.push([]);
              }
              for (var cc = 0; cc < matrix[rr].length; cc++) {
                self._rows[targetRowIdx][col - 1 + cc] = matrix[rr][cc];
              }
            }
          }
        };
      }
    };
  }

  for (var i = 0; i < PB_SHEET_NAMES_.length; i++) {
    var sName = PB_SHEET_NAMES_[i];
    var schema = PB_SHEET_SCHEMAS_[sName];
    var initRows = [schema.headers.slice()];
    if (sourceSs && typeof sourceSs.getSheetByName === 'function') {
      var srcSheet = sourceSs.getSheetByName(sName);
      if (srcSheet && srcSheet.getLastRow() > 0) {
        var vals = srcSheet
          .getRange(1, 1, srcSheet.getLastRow(), schema.headers.length)
          .getValues();
        initRows = [];
        for (var vIdx = 0; vIdx < vals.length; vIdx++) {
          initRows.push(vals[vIdx].slice());
        }
      }
    }
    sheetMap[sName] = makeDisposableSheet(sName, initRows);
  }

  return {
    isSyntheticSandbox: true,
    getId: function () {
      return 'SYNTHETIC_SANDBOX_SPREADSHEET_STEP15';
    },
    getName: function () {
      return 'PB_LMS_Step15_Disposable_Synthetic_Sandbox';
    },
    getSheetByName: function (name) {
      return sheetMap[name] || null;
    },
    insertSheet: function (name) {
      var schema = PB_SHEET_SCHEMAS_[name];
      var headers = schema ? schema.headers.slice() : ['id'];
      sheetMap[name] = makeDisposableSheet(name, [headers]);
