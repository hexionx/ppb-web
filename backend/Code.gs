        leaksPasswordHash: leaksPasswordHash,
        postLogoutCode: postLogoutCode
      }
    );

    /* --------------------------------------------------------------------
     * DOMAIN 3: AUTHORIZATION (RBAC, IDOR, REVOKED ENROLLMENT)
     * -------------------------------------------------------------------- */
    var enrolledCtx = {
      authenticated: true,
      user: synth.enrolledStudent,
      session: { session_id: 'ses_s15_enrolled' }
    };
    var otherStuCtx = {
      authenticated: true,
      user: synth.otherStudent,
