function handleAuthLogin_(payload) {
  if (typeof authenticateUserLogin_ !== 'function') {
    throw createAppError_(
      PB_ERROR_CODES_.ERR_CONFIG_MISSING,
      'Step 4/5 backend files are missing in the Apps Script editor. Please add CryptoService.gs, RateLimitService.gs, and AuthService.gs, update Config.gs, and press Ctrl+S.'
    );
  }
  var res = authenticateUserLogin_(payload);
  var currentVer = getCurrentPrivacyNoticeVersion_();
  var rawTok = String(res.sessionToken || res.authToken || '').trim();
  var enrichedUser = res.user || null;
  if (enrichedUser && enrichedUser.userId) {
    try {
      var dbUser = getSheetRecordById_('Users', enrichedUser.userId);
      if (dbUser) {
        enrichedUser = buildPublicUserSummary_(dbUser, currentVer);
      }
    } catch (ignoreEnrichErr) {}
  }
  return {
    sessionToken: rawTok,
    authToken: rawTok,
    sessionId: res.sessionId,
    expiresAtUtc: res.expiresAtUtc,
    expiresAtBangkok: res.expiresAtBangkok,
    rememberMe: Boolean(res.rememberMe),
    privacyNoticeVersion: currentVer,
    user: enrichedUser
  };
}

