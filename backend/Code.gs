/* ==========================================================================
 * DATABASE FACTORY RESET WITH MANDATORY 2-STEP EMAIL OTP VERIFICATION
 * - Step 1: `admin.requestFactoryResetOtp` / `editorRequestFactoryResetOtp_()`
 *   Generates a 6-digit one-time passcode (10-minute expiry, max 5 attempts),
 *   stores its SHA-256 hash in CacheService / PropertiesService, and sends the
 *   OTP to the configured school administrator email via MailApp.sendEmail.
 * - Step 2: `admin.executeFactoryReset` / `editorConfirmFactoryResetWithOtp_()`
 *   Verifies the 6-digit OTP, the administrator's current password (when called
 *   via Web UI), and the mandatory confirmation phrase ("FACTORY RESET"), then
 *   clears all data rows across all 16 Google Sheets tabs while preserving the
 *   row-1 schema headers (and optionally preserving the active Admin account
 *   and school Settings when `keepCurrentAdmin` is true).
 * ========================================================================== */

var PB_FACTORY_RESET_OTP_PROP_KEY_ = 'PB_FACTORY_RESET_OTP_STATE_V1';
var PB_FACTORY_RESET_CONFIRM_PHRASE_ = 'FACTORY RESET';

function resolveFactoryResetRecipientEmail_(opt_adminUser) {
  var candidate = '';
  try {
    var settingsTbl = readSheetTable_('Settings');
    if (settingsTbl && settingsTbl.byId) {
      if (
        settingsTbl.byId.ADMIN_NOTIFICATION_EMAIL &&
        settingsTbl.byId.ADMIN_NOTIFICATION_EMAIL.record.setting_value
      ) {
        candidate = String(
          settingsTbl.byId.ADMIN_NOTIFICATION_EMAIL.record.setting_value
        ).trim();
      }
      if (
        !candidate &&
        settingsTbl.byId.CONTACT_EMAIL &&
        settingsTbl.byId.CONTACT_EMAIL.record.setting_value
      ) {
        candidate = String(
          settingsTbl.byId.CONTACT_EMAIL.record.setting_value
        ).trim();
      }
    }
  } catch (ignoreSettingsErr) {}

  if (
    (!candidate || candidate.indexOf('example.com') !== -1) &&
    opt_adminUser &&
    opt_adminUser.email &&
    String(opt_adminUser.email).indexOf('example.com') === -1
  ) {
    candidate = String(opt_adminUser.email).trim();
  }
  if (!candidate || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(candidate)) {
    candidate = 'phuwadet.khu@student.mahidol.edu';
  }
  return candidate;
}

function generateSixDigitOtpCode_() {
  var seed =
    Utilities.getUuid() +
    '|' +
    String(new Date().getTime()) +
    '|' +
    String(Math.random());
  var digest = Utilities.computeDigest(
    Utilities.DigestAlgorithm.SHA_256,
    seed,
    Utilities.Charset.UTF_8
  );
  var num =
    (((digest[0] & 0xff) << 24) |
      ((digest[1] & 0xff) << 16) |
      ((digest[2] & 0xff) << 8) |
      (digest[3] & 0xff)) >>>
    0;
  var sixDigits = String(100000 + (num % 900000));
  return sixDigits;
}

function computeOtpHashHex_(otpCode, saltStr) {
  var bytes = Utilities.computeDigest(
    Utilities.DigestAlgorithm.SHA_256,
    String(saltStr || '') + ':' + String(otpCode || '').trim(),
    Utilities.Charset.UTF_8
  );
  var hex = '';
  for (var i = 0; i < bytes.length; i++) {
    var b = bytes[i] < 0 ? bytes[i] + 256 : bytes[i];
    var h = b.toString(16);
    hex += h.length === 1 ? '0' + h : h;
  }
  return hex;
}

function saveFactoryResetOtpState_(stateObj) {
  var json = JSON.stringify(stateObj);
  try {
    if (typeof CacheService !== 'undefined' && CacheService) {
      var c = CacheService.getScriptCache();
      if (c) c.put(PB_FACTORY_RESET_OTP_PROP_KEY_, json, 600);
    }
  } catch (ignoreCacheErr) {}
  try {
    if (typeof PropertiesService !== 'undefined' && PropertiesService) {
      var p = PropertiesService.getScriptProperties();
      if (p) p.setProperty(PB_FACTORY_RESET_OTP_PROP_KEY_, json);
    }
  } catch (ignorePropErr) {}
}

function readFactoryResetOtpState_() {
  var raw = null;
  try {
    if (typeof CacheService !== 'undefined' && CacheService) {
      var c = CacheService.getScriptCache();
      raw = c ? c.get(PB_FACTORY_RESET_OTP_PROP_KEY_) : null;
    }
  } catch (ignoreCacheErr) {}
  if (!raw) {
    try {
      if (typeof PropertiesService !== 'undefined' && PropertiesService) {
        var p = PropertiesService.getScriptProperties();
        raw = p ? p.getProperty(PB_FACTORY_RESET_OTP_PROP_KEY_) : null;
      }
    } catch (ignorePropErr) {}
  }
  if (!raw) return null;
  try {
    return JSON.parse(raw);
  } catch (parseErr) {
    return null;
  }
}

function clearFactoryResetOtpState_() {
  try {
    if (typeof CacheService !== 'undefined' && CacheService) {
      var c = CacheService.getScriptCache();
      if (c) c.remove(PB_FACTORY_RESET_OTP_PROP_KEY_);
    }
  } catch (ignoreCacheErr) {}
  try {
    if (typeof PropertiesService !== 'undefined' && PropertiesService) {
      var p = PropertiesService.getScriptProperties();
      if (p) p.deleteProperty(PB_FACTORY_RESET_OTP_PROP_KEY_);
    }
  } catch (ignorePropErr) {}
}

