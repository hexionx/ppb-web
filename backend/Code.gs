    for (var eIdx = 0; eIdx < enrollmentsTbl.records.length; eIdx++) {
      var enr = enrollmentsTbl.records[eIdx];
      if (enr.course_id === courseId && enr.status === 'ACTIVE') {
        var uHit = usersTbl.byId[enr.user_id];
